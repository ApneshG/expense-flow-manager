# Required: Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: SendGrid for transactional email (invitations, password resets)
SENDGRID_API_KEY=

# Optional: From-address + default admin user
ADMIN_EMAIL=akshatgera@gmail.com

# Optional: Public URL of the deployed app (used in email links)
# On Render this is auto-set as RENDER_EXTERNAL_URL — leave APP_URL blank
APP_URL=

# Optional: OpenAI key powering the in-app Copilot (CFO + HoD dashboards)
# If unset, the chat widget shows a "Copilot not configured" message.
OPENAI_API_KEY=

# Optional: Port the server listens on (defaults to 5000)
PORT=5000
